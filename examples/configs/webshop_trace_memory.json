{
  "workload": {
    "name": "webshop",
    "cases": [
      0,
      1
    ],
    "params": {
      "capture_observations": true,
      "environment_python": "../../.venv-webshop/bin/python"
    }
  },
  "memory": {
    "name": "recent_failure_traces",
    "factory": {
      "entrypoint": "../memory_strategy/initial_strategy.py:create_memory"
    }
  },
  "model": {
    "name": "YOUR_MODEL_NAME",
    "api_key_env": "OPENAI_API_KEY",
    "request_options": {}
  },
  "trials": 6,
  "max_environment_steps": 15,
  "require_provider_usage": true,
  "shared_t1_dir": "../../runs/webshop_retry",
  "timeout_seconds": 600,
  "output_dir": "../../runs/webshop_trace_memory",
  "actor": {
    "name": "openhands",
    "params": {
      "max_output_tokens": 1024
    }
  }
}
